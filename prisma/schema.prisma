// WLABS - Website Laboratory
// Prisma schema - PostgreSQL
// Run `npx prisma generate` after any change (also runs automatically via postinstall).
// Run `npx prisma migrate dev --name <name>` to create a new migration during development.
// Run `npx prisma migrate deploy` (or `npm run db:migrate:deploy`) to apply migrations in production.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// =========================================================
// Enums
// =========================================================

/// CRM pipeline status for a Lead - see docs/scoring-rubric.md
enum LeadStatus {
  imported
  qualified
  rejected
  crawled
  audited
  high_opportunity
  medium_opportunity
  low_opportunity
  dedicated_sales
  preview_generated
  preview_qc_passed
  preview_needs_review
  email_drafted
  email_qc_passed
  approved
  contacted
  replied
  booked_call
  won
  lost
  suppressed
}

/// Output of the Lead Qualification Agent
enum LeadQualification {
  ready_for_crawl
  needs_manual_review
  rejected
}

/// Output of the Website Audit Agent (and Audit.qualificationStatus)
enum OpportunityLevel {
  high_opportunity
  medium_opportunity
  low_opportunity
  reject
}

/// Output of the Website Crawl Agent
enum CrawlStatus {
  pending
  success
  failed
  blocked
  timeout
  invalid_url
}

/// Shared QC status used by Preview QC Agent and Email QC Agent
enum QcStatus {
  passed
  needs_review
  failed
}

/// Lifecycle status of a generated Preview
enum PreviewStatus {
  draft
  generated
  needs_review
  approved
  published
}

/// Lifecycle status of an EmailDraft
enum EmailStatus {
  draft
  needs_review
  do_not_send
  approved
  exported
  sent
  bounced
  opted_out
}

/// Email Drafting Agent variants
enum EmailVariant {
  direct_preview
  audit_first
  audit_comparison
  soft_consult
  follow_up_1
  follow_up_2
  breakup
}

/// Status of an inbound request from the public site
enum InboundRequestStatus {
  new
  processing
  converted
  closed
}

/// Status of a WorkflowRun (Agent Architecture Requirements)
enum WorkflowRunStatus {
  pending
  running
  waiting_for_approval
  completed
  failed
  cancelled
  paused
}

/// Status of an individual WorkflowStep (agent execution)
enum AgentStepStatus {
  pending
  running
  completed
  failed
  skipped
  waiting_for_approval
  retrying
}

/// Status of a Scope Market discovery run
enum DiscoveryRunStatus {
  discovering
  processing
  completed
  failed
}

/// Stripe payment status for a Lead's fixed-price MVP checkout.
enum PaymentStatus {
  unpaid
  pending
  paid
  refunded
}

/// Social media platforms for WLABS brand content.
enum SocialPlatform {
  instagram
  linkedin
}

/// Lifecycle status of a SocialPost.
enum SocialPostStatus {
  draft
  needs_review
  approved
  scheduled
  posted
  failed
}

// =========================================================
// Core CRM models
// =========================================================

model Lead {
  id           String  @id @default(cuid())
  businessName String
  slug         String  @unique
  industry     String
  websiteUrl   String?
  city         String?
  country      String?

  contactEmail  String?
  contactPhone  String?
  contactPerson String?

  source    String?
  sourceUrl String?
  notes     String?

  /// Google Places place_id when sourced via Scope Market - dedup key across repeat runs.
  discoverySourceId String? @unique
  /// IndustryKey searched when this lead was discovered.
  discoveryCategory String?

  status              LeadStatus         @default(imported)
  qualificationStatus LeadQualification?
  auditScore          Int?
  doNotContact        Boolean            @default(false)

  paymentStatus           PaymentStatus @default(unpaid)
  stripeCustomerId        String?
  stripeCheckoutSessionId String?       @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  websiteCaptures   WebsiteCapture[]
  audits            Audit[]
  redesignBriefs    RedesignBrief[]
  previews          Preview[]
  emailDrafts       EmailDraft[]
  activities        Activity[]
  workflowSteps     WorkflowStep[]
  inboundRequests   InboundRequest[]
  intakeSubmissions IntakeSubmission[]

  @@index([status])
  @@index([industry])
  @@index([websiteUrl])
  @@index([contactEmail])
  @@index([qualificationStatus])
  @@index([paymentStatus])
}

model WebsiteCapture {
  id     String @id @default(cuid())
  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  html            String? @db.Text
  title           String?
  metaDescription String?
  h1              String?
  extractedText   String? @db.Text

  desktopScreenshotUrl String?
  mobileScreenshotUrl  String?

  lighthouseJson    Json?
  extractedDataJson Json?

  crawlStatus  CrawlStatus @default(pending)
  errorMessage String?

  createdAt DateTime @default(now())

  @@index([leadId])
}

model Audit {
  id     String @id @default(cuid())
  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  overallScore       Int
  categoryScoresJson Json
  topIssuesJson      Json
  quickWinsJson      Json

  recommendedPositioning       String?
  recommendedPageStructureJson Json?
  salesAngle                   String?
  urgencyReason                String?
  redesignPotential            String?

  /// Harsher, specific UX/conversion problems (AI-enhanced; template fallback in mock mode).
  criticalFindingsJson   Json?
  /// 1-2 sentence comparison to best-practice sites in the same industry.
  bestPracticeComparison String?
  /// Qualitative gap vs. market benchmarks.
  benchmarkGap           String?

  /// Visual design quality score from Claude Vision (0-10). Null when no screenshot available.
  visualScore     Int?
  /// Full visual audit output from Claude Vision (colorHarmony, typography, etc.).
  visualAuditJson Json?

  qualificationStatus OpportunityLevel

  createdAt DateTime @default(now())

  @@index([leadId])
}

model RedesignBrief {
  id     String @id @default(cuid())
  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  industry        String?
  businessSummary String? @db.Text
  targetCustomer  String?

  currentWeaknessesJson     Json?
  redesignOpportunitiesJson Json?

  recommendedHeadline     String?
  recommendedSubheadline  String?
  suggestedCtasJson       Json?
  recommendedSectionsJson Json?

  visualStyleDirection    String?
  credibilityElementsJson Json?
  localSeoAngle           String?
  beforeAfterNarrative    String? @db.Text
  emailPitchAngle         String? @db.Text

  createdAt DateTime @default(now())

  @@index([leadId])
}

model Preview {
  id     String @id @default(cuid())
  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  slug  String  @unique
  token String? @unique

  status PreviewStatus @default(draft)

  contentJson Json
  themeJson   Json?
  previewUrl  String?

  viewCount     Int @default(0)
  ctaClickCount Int @default(0)

  qcStatus     QcStatus?
  qcIssuesJson Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([leadId])
  @@index([status])
}

model EmailDraft {
  id     String @id @default(cuid())
  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  subject String
  body    String       @db.Text
  variant EmailVariant

  status EmailStatus @default(draft)

  personalizationJson Json?
  complianceFlagsJson Json?

  qcStatus     QcStatus?
  qcIssuesJson Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([leadId])
  @@index([status])
  @@index([variant])
}

model Activity {
  id     String @id @default(cuid())
  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  type         String
  description  String
  metadataJson Json?

  createdAt DateTime @default(now())

  @@index([leadId])
  @@index([type])
}

model Suppression {
  id String @id @default(cuid())

  email      String?
  websiteUrl String?
  reason     String

  createdAt DateTime @default(now())

  @@index([email])
  @@index([websiteUrl])
}

model InboundRequest {
  id String @id @default(cuid())

  name         String
  businessName String?
  websiteUrl   String?
  email        String
  phone        String?
  industry     String?
  message      String? @db.Text

  status InboundRequestStatus @default(new)

  leadId String?
  lead   Lead?   @relation(fields: [leadId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([status])
  @@index([email])
}

/// Richer brief submitted by an interested lead via the public intake form
/// (linked to a Preview's slug/token). Preferred over crawled/inferred data
/// when generating or regenerating a preview.
model IntakeSubmission {
  id     String @id @default(cuid())
  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  targetCustomer  String? @db.Text
  brandColorsJson Json?
  preferredDomain String?
  additionalNotes String? @db.Text

  createdAt DateTime @default(now())

  @@index([leadId])
}

// =========================================================
// Internal agentic workflow engine
// =========================================================

model WorkflowRun {
  id String @id @default(cuid())

  workflowType String
  status       WorkflowRunStatus @default(pending)

  startedAt   DateTime?
  completedAt DateTime?
  createdBy   String?

  metadataJson Json?

  createdAt DateTime @default(now())

  steps        WorkflowStep[]
  discoveryRun DiscoveryRun?

  @@index([workflowType])
  @@index([status])
}

model WorkflowStep {
  id            String      @id @default(cuid())
  workflowRunId String
  workflowRun   WorkflowRun @relation(fields: [workflowRunId], references: [id], onDelete: Cascade)

  leadId String?
  lead   Lead?   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  agentName String
  status    AgentStepStatus @default(pending)

  inputJson  Json?
  outputJson Json?
  errorJson  Json?

  startedAt   DateTime?
  completedAt DateTime?
  retryCount  Int       @default(0)

  createdAt DateTime @default(now())

  @@index([workflowRunId])
  @@index([leadId])
  @@index([agentName])
  @@index([status])
}

/// A single "Scope Market" discovery run - searches Google Places for SMBs in a
/// city/category, imports weak-site leads, and tracks the background pipeline phase.
model DiscoveryRun {
  id String @id @default(cuid())

  workflowRunId String      @unique
  workflowRun   WorkflowRun @relation(fields: [workflowRunId], references: [id], onDelete: Cascade)

  city        String
  country     String?
  industries  String[]
  targetCount Int

  status DiscoveryRunStatus @default(discovering)

  /// Lead ids created by this run - drives the background pipeline phase and progress display.
  leadIds           String[]
  placesFound       Int      @default(0)
  imported          Int      @default(0)
  skippedDuplicate  Int      @default(0)
  skippedSuppressed Int      @default(0)

  dedicatedSalesCount Int @default(0)
  prospectsCount      Int @default(0)

  createdBy   String?
  createdAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([createdAt])
}

// =========================================================
// WLABS brand social media content
// =========================================================

/// A generated or scheduled social post for WLABS's own Instagram / LinkedIn accounts.
model SocialPost {
  id       String         @id @default(cuid())
  platform SocialPlatform
  postType String

  caption     String          @db.Text
  hashtags    String[]
  imageUrl    String?
  imagePrompt String?         @db.Text

  status       SocialPostStatus @default(draft)
  scheduledFor DateTime?
  postedAt     DateTime?
  externalId   String?
  failureReason String?

  workflowRunId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([platform, status])
  @@index([scheduledFor])
}
